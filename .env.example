# Frontend (Vite) — copy to .env.local for local dev. Do not commit secrets.

# Yandex ID OAuth — required for "Connect with Yandex ID" to save a mail account.
# Without mail scopes, OAuth may succeed but the account will not be saved.
# Also enable these scopes on your app at https://oauth.yandex.ru (redirect: http://localhost:17248).
# VITE_YANDEX_OAUTH_CLIENT_ID=
VITE_YANDEX_OAUTH_SCOPES=mail:imap_full,mail:smtp,calendar:all,login:email,login:info,login:avatar,cloud_api:disk.read,cloud_api:disk.write,tracker:read,tracker:write,directory:read_organization,telemost-api:conferences.create,telemost-api:conferences.read,telemost-api:conferences.update

# Gmail is not shown in the provider picker by default.
# VITE_ENABLE_GMAIL_PROVIDER=false
