# Frontend (Vite) — copy to .env.local for local dev. Do not commit secrets.

# Yandex ID OAuth uses four public Client IDs with PKCE and one callback.
# Client secrets must never be placed in VITE_* or committed to the desktop bundle.
# Defaults point to the Office360 apps; overrides are useful for development only.
# VITE_YANDEX_OAUTH_CLIENT_ID=
# VITE_YANDEX_WORK_OAUTH_CLIENT_ID=
# VITE_YANDEX_COMMUNICATIONS_OAUTH_CLIENT_ID=
# VITE_YANDEX_ADMIN_OAUTH_CLIENT_ID=
VITE_YANDEX_OAUTH_SCOPES=mail:imap_full,mail:smtp,calendar:all,login:email,login:info,login:avatar

# Native build-time MVP values. Put real values in ignored .env.mvp.local; never use VITE_*.
# OFFICE360_YANDEX_MVP_CORE_CLIENT_SECRET=
# OFFICE360_YANDEX_MVP_WORK_CLIENT_SECRET=
# OFFICE360_YANDEX_MVP_COMMUNICATIONS_CLIENT_SECRET=
# OFFICE360_YANDEX_MVP_ADMIN_CLIENT_SECRET=

# Native runtime overrides. Production must rotate all four secrets and use a broker/runtime.
# OFFICE360_YANDEX_CORE_CLIENT_SECRET=
# OFFICE360_YANDEX_WORK_CLIENT_SECRET=
# OFFICE360_YANDEX_COMMUNICATIONS_CLIENT_SECRET=
# OFFICE360_YANDEX_ADMIN_CLIENT_SECRET=

# Gmail is not shown in the provider picker by default.
# VITE_ENABLE_GMAIL_PROVIDER=false
